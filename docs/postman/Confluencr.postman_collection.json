          "mode": "raw",
          "raw": "{\n  \"from_account_id\": \"{{source_account_id}}\",\n  \"to_account_id\": \"{{destination_account_id}}\",\n  \"amount\": \"30.00\",\n  \"reference_id\": \"docs-{{run_id}}-transfer\"\n}",
          "options": {
