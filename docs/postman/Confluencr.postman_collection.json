{
  "info": {
    "name": "Confluencr Transaction Ledger API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Contract version 1.0.0. Run in listed order against a development database. Creates fresh Alice/Bob accounts, captures IDs and generates a new run_id for reference isolation. Final balances: Alice 50.00 / Bob 80.00. Re-running creates another pair of accounts; no ledger history is deleted. No authentication is implemented. See docs/API_REFERENCE.md for failure recovery and exact error semantics. Generated from scripts/postman.ts and openapi.yaml; regenerate with npm run docs:generate."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:3000",
      "type": "string"
    },
    {
      "key": "run_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "source_account_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "destination_account_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Health and initialize run",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health",
        "description": "01 Health and initialize run",
        "header": []
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"run_id\", pm.variables.replaceIn(\"{{$guid}}\"));",
              "pm.collectionVariables.unset(\"source_account_id\");",
              "pm.collectionVariables.unset(\"destination_account_id\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"01 Health and initialize run: HTTP 200\", function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test(\"01 Health and initialize run: response contract\", function () {",
              "  pm.expect(body.status).to.equal(\"ok\");",
              "});"
            ]
          }
        }
      ]
    },
    {
