      "request": {
        "method": "POST",
        "url": "{{base_url}}/accounts",
        "description": "03 Create Alice",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alice\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"03 Create Alice: HTTP 201\", function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.test(\"03 Create Alice: response contract\", function () {",
              "  pm.expect(body.name).to.equal(\"Alice\");",
              "  pm.expect(body.balance).to.equal(\"0.00\");",
              "  pm.expect(body.id).to.match(/^[0-9a-f-]{36}$/);",
              "  pm.collectionVariables.set(\"source_account_id\", body.id);",
              "});"
            ]
          }
        }
      ]
    },
