NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Optional; tests default to a disposable local PostgreSQL server.
# External tests require a dedicated cluster and explicit opt-in; see README.
# TEST_DATABASE_URL=postgresql://TEST_USER:TEST_PASSWORD@TEST_HOST:5432/postgres
# LEDGER_EXTERNAL_TESTS=allow-create-disposable-database
# Remote connections always verify TLS; optional provider CA PEM file:
# DB_SSL_CA_FILE=/absolute/path/to/supabase-ca.crt
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
