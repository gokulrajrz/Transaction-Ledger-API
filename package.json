{
  "name": "confluencr-ledger-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:local": "node --import tsx scripts/local.ts",
    "supabase:start": "supabase start --exclude gotrue,realtime,storage-api,imgproxy,mailpit,edge-runtime,logflare,vector,supavisor",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit.test.ts",
    "test:integration": "vitest run tests/ledger.test.ts",
    "docs:validate": "tsx scripts/validate-openapi.ts",
    "migrations:verify": "tsx scripts/verify-supabase.ts",
    "runtime:verify": "tsx scripts/verify-runtime.ts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm run docs:validate && npm test && npm run migrations:verify && npm run runtime:verify"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^17.10.0-beta.17",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  }
}
